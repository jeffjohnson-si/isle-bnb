{
  "name": "isle-bnb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Isle BnB \u2014 book unique island stays across the Pacific. Pay on arrival.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "icons": "python scripts/make-icons.py",
    "check": "node scripts/visual-check.mjs",
    "api": "node server/index.mjs",
    "api:watch": "node --watch server/index.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
