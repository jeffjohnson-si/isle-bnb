# API (server/index.mjs)
PORT=8787
# Change this before exposing the API. Required for the admin endpoints.
ADMIN_TOKEN=dev-admin-token
# Only needed when the web app is served from a different origin than the API.
# Example: https://islebnb.com
ALLOWED_ORIGIN=
# Where the SQLite file lives. Defaults to ./data
DATA_DIR=

# Web app (Vite). Leave empty when /api is proxied on the same origin.
VITE_API_BASE=
