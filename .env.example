# API (server/index.mjs)
PORT=8787
# Change this before exposing the API. Required for the admin endpoints.
ADMIN_TOKEN=dev-admin-token
# Only needed when the web app is served from a different origin than the API.
# Example: https://islebnb.com
ALLOWED_ORIGIN=
# Where the SQLite file lives. Defaults to ./data
DATA_DIR=

# Transactional email (Brevo). Without an API key every message is logged to the
# console instead of sent, so local work needs no account.
BREVO_API_KEY=
# A sender Brevo has verified. Name is optional: "Isle BnB <bookings@islebnb.com>"
MAIL_FROM="Isle BnB <bookings@islebnb.local>"
# Copy of every booking, application and claim for the team.
OPS_INBOX=
# Used in notification and host-invitation links. Must be your public address in
# production, with no trailing slash.
SITE_URL=http://localhost:5180

# Web app (Vite). Leave empty when /api is proxied on the same origin.
VITE_API_BASE=
